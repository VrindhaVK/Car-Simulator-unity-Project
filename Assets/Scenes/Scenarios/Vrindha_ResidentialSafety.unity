--- !u!1001 &1115650453
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1383494532}
    m_Modifications:
    - target: {fileID: 7000201977008960357, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_AnchorMax.x
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7000201977008960357, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7000201977008960357, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_AnchorMin.y
      value: 0.4324659
      objectReference: {fileID: 0}
    - target: {fileID: 7000201977533288890, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_Size
      value: 0.5675341
      objectReference: {fileID: 0}
    - target: {fileID: 7000201978217335538, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_Text
      value: "<size=18><b>Keyboard</b>\r</size>\n\n<b>Startup</b>\r\n\nK\t\t\t\t\t\t\t\t\t\tIgnition
        Key:\r\n\t\t\t\t\t\t\t\t\t\t\u2022\tPress once to move the key from \"Off\"
        to \"Acc-On\"\r\n\t\t\t\t\t\t\t\t\t\t\u2022\tPress and hold to Start the
        engine\r\nCtrl+K\t\t\t\t\t\t\tSwitch engine off\r\n\n<b>Driving</b>\r\n\nArrows
        / WSAD\t\tThrottle, Brake, Steering\r\nSpace\t\t\t\t\t\t\tHandbrake\r\nCtrl+Space\t\t\t\tToggle
        parking brake\r\nShift\t\t\t\t\t\t\t\tClutch\r\n\n<b>Manual Transmission</b>\r\n\nTab\t\t\t\t\t\t\t\tGear
        Shift Up\r\nCaps-Lock\t\t\t\t\tGear Shift Down\r\nN\t\t\t\t\t\t\t\t\t\tNeutral
        gear\r\nR\t\t\t\t\t\t\t\t\t\tEngage Reverse gear\r\n1..5\t\t\t\t\t\t\t\tEngage
        specific gear\r\n\r\n<b>Automatic Transmission [M P R N D L]</b>\r\n\nPage-Up\t\t\t\t\t\tPrevious
        Gear Mode\r\nPage-Down\t\t\t\tNext Gear Mode\r\nR\t\t\t\t\t\t\t\t\t\tReverse
        Mode [R]\r\n1\t\t\t\t\t\t\t\t\t\tDrive mode [D]\r\nTab\t\t\t\t\t\t\t\tGear
        Shift Up ([M] mode)\r\nCaps-Lock\t\t\t\t\tGear Shift Down ([M] mode)\r\n\n\t\tNote:
        Entering or leaving the Park mode [P] requires the brakes to be pressed\r.\n\n<b>Demo</b>\r\n\nEsc\t\t\t\t\t\t\t\t\tDemo
        options (Reset, Quit)\nReturn\t\t\t\t\t\t\tReset car (i.e. if rolls over)\r\n\rC,
        F1-F4\t\t\t\t\t\tChange camera\nT\t\t\t\t\t\t\t\t\t\tToggle slow motion mode\r"
      objectReference: {fileID: 0}
    - target: {fileID: 7000201978217335538, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_FontData.m_FontSize
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 7000201978217335538, guid: 06ccb6ed0e7344e42b14f8b1b4865461, type: 3}
      propertyPath: m_FontData.m_LineSpacing
      value: 1.1
      objectReference: {fileID: 0}
